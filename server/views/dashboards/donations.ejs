<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donations' Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script crossorigin="anonymous" src="https://kit.fontawesome.com/3eb5f00bae.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300..700&family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap"
          rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Public Sans', sans-serif;
        }

        .header {
            background-color: #343a40;
            color: #f8f9fa;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .header-title {
            font-weight: 700;
            font-size: 3.2rem;
            color: #f8f9fa;
        }

        .chart-container {
            position: relative;
            height: 250px;
        }

        /* Custom CSS for layout */
        .header-content {
            padding: 15px;
            text-align: left;
            border-radius: 15px;
            margin-bottom: 15px;
        }

        .header-content h3,
        .header-content h2 {
            margin-bottom: 10px;
        }

        .badge {
            font-size: 0.9em;
        }
    </style>
    <%- include('../partials/sidebar') %>
    <div class="container mt-4">
        <div class="row">
            <div class="col-12">
                <div class="header border-0 rounded shadow">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h1 class="header-title"><i class="fas fa-socks fa-lg"></i>&nbsp;reciclatextil</h1>
                            <div class="py-3 px-3">
                                <h3><i class="fa-solid fa-shirt"></i>&nbsp; <%= data[1][0].totalDonations %></h3>
                                <h3><i class="fa-solid fa-weight-hanging"></i>&nbsp; <%= data[3][0].totalWeight %></h3>
                                <h3><i class="fa-solid fa-weight-hanging"></i>&nbsp; <%= data[4][0].averageWeight %> ~</h3>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h2>Donations per Month</h2>
                            <div class="chart-container">
                                <canvas id="donationsPerMonth"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="jumbotron py-3">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="display-6">Users</h1>
                </div>
                <div class="col-md-6">
                    <div class="card bg-white border-0 shadow">
                        <div class="card-body">
                            <h2 class="card-title">Top 10 Donators</h2>
                            <div class="chart-container">
                                <canvas id="topDonators"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-white border-0 shadow">
                        <div class="card-body">
                            <h2 class="card-title">Top 10 Donated Items</h2>
                            <div class="chart-container">
                                <canvas id="topItems"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div>
        <div class="container py-3">
            <div class="row">
                <div class="col-12">
                    <h1 class="display-6">Benefactors</h1>
                    <div class="card bg-white border-0 shadow">
                        <div class="card-body">
                            <h2 class="card-title">Top 10 Benefactors</h2>
                            <div class="chart-container">
                                <canvas id="topBenefactors"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const topItemsGraph = document.getElementById("topItems")
        const topBenefactorsGraph = document.getElementById("topBenefactors")
        const topDonatorsGraph = document.getElementById("topDonators")
        const donationsPerMonthGraph = document.getElementById("donationsPerMonth")

        <%

        let topDonators = data[0];
        let topItems = data[5];
        let donationsPerMonth = data[2];
        let topBenefactors = data[6];

        function getMonthName(monthNumber) {
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            return monthNames[monthNumber - 1];
        }
        %>
        new Chart(donationsPerMonthGraph, {
            type: 'line',
            data: {
                labels: <%- JSON.stringify(donationsPerMonth.map(item => getMonthName(item._id)))%>,
                datasets: [{
                    label: 'Number of donations',
                    data: <%- JSON.stringify(donationsPerMonth.map(item => item.totalDonations))%>,
                    fill: true,
                    backgroundColor: 'rgba(255, 255, 255, 0.1)', // white background with 10% opacity
                    borderColor: '#06D6A0',
                    tension: 0.1
                }]
            }
        })
        <%- console.log(donationsPerMonth)%>
        new Chart(topBenefactorsGraph,
            {
                type: 'bar',
                data: {
                    labels: <%- JSON.stringify(topBenefactors.map(item => item.benefactor[0].name))%>,
                    datasets: [{
                        label: 'Number of donations given to this benefactor.',
                        data: <%- JSON.stringify(topBenefactors.map(item => item.totalDonations))%>,
                        backgroundColor: '#7B2'
                    }]
                }
            })
        new Chart(topDonatorsGraph,
            {
                type: 'bar',
        data: {
            labels: <%- JSON.stringify(topDonators.map(item => item.username)) %>,
            datasets: [
                {
                    label: 'Number of donations.',
                    data: <%- JSON.stringify(topDonators.map(item => item.totalDonations)) %>,
                    backgroundColor: '#FF6B6B'
                }]
        }
            });
        new Chart(topItemsGraph,
            {
                type: 'bar',
                data: {
                    labels: <%- JSON.stringify(topItems.map(item => item._id)) %>,
                    datasets: [
                        {
                            label: 'Number of donations that include that type of item.',
                            data: <%- JSON.stringify(topItems.map(item => item.totalDonations))%>,
                            backgroundColor: '#FF6'
                        }]
                }
            });
    </script>

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
<%- include('../partials/footer') %>