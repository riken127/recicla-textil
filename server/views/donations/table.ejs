<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Donations</title>
    <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css"
    />
    <script
            crossorigin="anonymous"
            src="https://kit.fontawesome.com/3eb5f00bae.js"
    ></script>
    <link
            rel="stylesheet"
            type="text/css"
            href="https://cdn.datatables.net/2.0.3/css/dataTables.bootstrap5.css"
    />
    <style>
        .country-select {
            width: 100%;
        }

        .iti {
            width: 100%;
        }
    </style>
    <%- include('../partials/sidebar') %>
    <!--Donations Table-->
    <div class="container md-col-12 mb-3 py-4">
        <table
                id="donationsTable"
                class="table table-striped display"
                style="width: 100%"
        ></table>
    </div>

    <!-- Create Donation Modal -->
    <div
            class="modal fade"
            id="createModal"
            tabindex="-1"
            aria-labelledby="createModalLabel"
            aria-hidden="true"
    >
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalLabel">
                        <i class="fa-solid fa-hand-holding-heart"></i> Create Donation
                    </h5>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                    ></button>
                </div>
                <div class="modal-body">
                    <div
                            class="alert alert-danger alert-dismissible fade mb-3 w-100 align-self-center"
                            role="alert"
                            id="errorAlert"
                            style="display: none"
                    >
                        <i class="fa-solid fa-circle-exclamation fa-shake fa-xl"></i>
                        <span id="errorMessage">This is an error message</span>
                        <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close"
                        ></button>
                    </div>
                    <form id="createDonationForm" method="POST">
                        <!--Labels for User and Benefactor-->
                        <div class="row">
                            <div class="col-md-6">
                                <label for="createUserName" class="form-label">User</label>
                            </div>
                            <div class="col-md-6">
                                <label for="createBenefactorName" class="form-label"
                                >Benefactor</label
                                >
                            </div>
                        </div>
                        <!--Input Fields for UserId, UserName, BenefactorId and BenefactorName-->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <input
                                        type="text"
                                        class="form-control"
                                        id="createUserName"
                                        name="userName"
                                        placeholder="Select User"
                                        readonly
                                />
                                <input type="hidden" id="createUserId" name="userId"/>
                            </div>
                            <div class="col-md-3">
                                <button
                                        id="openUserModalButton"
                                        type="button"
                                        class="btn btn-primary"
                                >
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                            <div class="col-md-3">
                                <input
                                        type="text"
                                        class="form-control"
                                        id="createBenefactorName"
                                        name="benefactorName"
                                        placeholder="Select Benefactor"
                                        readonly
                                />
                                <input
                                        type="hidden"
                                        id="createBenefactorId"
                                        name="benefactorId"
                                />
                            </div>
                            <div class="col-md-3">
                                <button
                                        id="openBenefactorModalButton"
                                        type="button"
                                        class="btn btn-primary"
                                >
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <!--Pickpoint Information-->
                        <div id="pickpointInfo" hidden>
                            <div class="row">
                                <div class="col-md-6">
                                    <label for="createPickpointAddress" class="form-label"
                                    >Pickpoint Address</label
                                    >
                                    <input
                                            type="hidden"
                                            id="createDonationPickpointId"
                                            name="pickpointId"
                                    />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-9">
                                    <input
                                            type="text"
                                            class="form-control"
                                            id="createPickpointAddress"
                                            readonly
                                    />
                                </div>
                                <div class="col-md-3">
                                    <button
                                            type="button"
                                            class="btn btn-primary"
                                            id="openPickpointModalButton"
                                    >
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="createTimestamp" name="timestamp"/>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">
                                Create Donation
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- User Modal to Create Donation -->
    <div class="modal" id="userModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Users</h4>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                    ></button>
                </div>
                <div class="modal-body">
                    <input
                            class="form-control"
                            id="userSearch"
                            type="text"
                            placeholder="Search..."
                    />
                    <div id="userContainer"></div>
                </div>
                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-danger"
                            data-bs-dismiss="modal"
                    >
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Benefactor Modal to Create Donation-->
    <div class="modal" id="benefactorModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Benefactor</h4>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                    ></button>
                </div>

                <div class="modal-body">
                    <input
                            class="form-control"
                            id="benefactorSearch"
                            type="text"
                            placeholder="Search..."
                    />
                    <div id="benefactorContainer"></div>
                </div>

                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-danger"
                            data-bs-dismiss="modal"
                    >
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Pickpoint Modal to create Donation-->
    <div class="modal" id="pickpointModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Pickpoints</h4>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                    ></button>
                </div>

                <div class="modal-body">
                    <input
                            class="form-control"
                            id="pickpointSearch"
                            type="text"
                            placeholder="Search by city..."
                    />
                    <div id="pickpointContainer"></div>
                </div>

                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-danger"
                            data-bs-dismiss="modal"
                    >
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Donation Modal -->
    <div
            class="modal fade"
            id="editModal"
            tabindex="-1"
            aria-labelledby="editModalLabel"
            aria-hidden="true"
    >
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">
                        <i class="fa-solid fa-hand-holding-heart"></i> Edit Donation
                    </h5>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                    ></button>
                </div>
                <div class="modal-body">
                    <form id="editDonationForm" method="POST">
                        <input type="hidden" id="editDonationId" name="donationId"/>
                        <!--Labels for User and Benefactor-->
                        <div class="row">
                            <div class="col-md-6">
                                <label for="editUserName" class="form-label">User</label>
                            </div>
                            <div class="col-md-6">
                                <label for="editBenefactorName" class="form-label"
                                >Benefactor</label
                                >
                            </div>
                        </div>
                        <!--Input Fields for UserId, UserName, BenefactorId and BenefactorName-->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <input
                                        type="text"
                                        class="form-control"
                                        id="editUserName"
                                        name="userName"
                                        placeholder="Select User"
                                        readonly
                                />
                                <input type="hidden" id="editUserId" name="userId"/>
                            </div>
                            <div class="col-md-3">
                                <button
                                        type="button"
                                        class="btn btn-primary"
                                        id="openEditUserModalButton"
                                >
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                            <div class="col-md-3">
                                <input
                                        type="text"
                                        class="form-control"
                                        id="editBenefactorName"
                                        name="benefactorName"
                                        placeholder="Select Benefactor"
                                        readonly
                                />
                                <input
                                        type="hidden"
                                        id="editBenefactorId"
                                        name="benefactorId"
                                />
                            </div>
                            <div class="col-md-3">
                                <button
                                        type="button"
                                        class="btn btn-primary"
                                        id="openEditBenefactorModalButton"
                                >
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <!--Pickpoint Information-->
                        <div id="editPickpointInfo">
                            <label for="editPickpointAddress" class="form-label"
                            >Pickpoint Address</label
                            >
                            <input
                                    type="hidden"
                                    id="editDonationPickpointId"
                                    name="pickpointId"
                            />
                            <div class="row">
                                <div class="row mb-3">
                                    <div class="col-md-9">
                                        <input
                                                type="text"
                                                class="form-control"
                                                id="editPickpointAddress"
                                                readonly
                                        />
                                    </div>
                                    <div class="col-md-3">
                                        <button
                                                type="button"
                                                class="btn btn-primary"
                                                id="openEditPickpointModalButton"
                                        >
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" id="editTimestamp" name="timestamp"/>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">
                                Edit Donation
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- User Modal to Edit Donation -->
    <div class="modal" id="editUserModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Users</h4>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                    ></button>
                </div>
                <div class="modal-body">
                    <input
                            class="form-control"
                            id="editUserSearch"
                            type="text"
                            placeholder="Search..."
                    />
                    <div id="editUserContainer"></div>
                </div>
                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-danger"
                            data-bs-dismiss="modal"
                    >
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Benefactor Modal to Edit Donation-->
    <div class="modal" id="editBenefactorModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Benefactor</h4>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                    ></button>
                </div>

                <div class="modal-body">
                    <input
                            class="form-control"
                            id="editBenefactorSearch"
                            type="text"
                            placeholder="Search..."
                    />
                    <div id="editBenefactorContainer"></div>
                </div>

                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-danger"
                            data-bs-dismiss="modal"
                    >
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Pickpoint Modal to Edit Donation-->
    <div class="modal" id="editPickpointModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Pickpoints</h4>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                    ></button>
                </div>

                <div class="modal-body">
                    <input
                            class="form-control"
                            id="editPickpointSearch"
                            type="text"
                            placeholder="Search by city..."
                    />
                    <div id="editPickpointContainer"></div>
                </div>

                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-danger"
                            data-bs-dismiss="modal"
                    >
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Delete Modal -->
    <div
            class="modal fade"
            id="deleteModal"
            tabindex="-1"
            aria-labelledby="deleteModalLabel"
            aria-hidden="true"
    >
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">
                        <i class="fa-solid fa-hand-holding-heart"></i> Delete Donation
                    </h5>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                    ></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this donation?</p>
                </div>
                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal"
                    >
                        No
                    </button>
                    <button type="button" class="btn btn-danger" id="confirmDelete">
                        Yes
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Items Modal -->
    <div
            class="modal fade"
            id="itemsModal"
            tabindex="-1"
            aria-labelledby="itemsModalLabel"
            aria-hidden="true"
    >
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="itemsModalLabel">
                        <i class="fa-solid fa-shirt"></i> Items
                    </h5>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                    ></button>
                </div>
                <div class="modal-body">
                    <div class="container md-col-12 mb-3 py-4">
                        <table
                                id="itemsTable"
                                class="table table-striped display"
                                style="width: 100%"
                        ></table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" id="openAddItemButton">
                        Add Item
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Item Modal -->
    <div
            class="modal fade"
            id="addItemModal"
            tabindex="-1"
            aria-labelledby="addItemModalLabel"
            aria-hidden="true"
    >
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addItemModalLabel">
                        <i class="fa-solid fa-shirt"></i> Add Item
                    </h5>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                    ></button>
                </div>
                <div class="modal-body">
                    <form id="addItemForm" class="row g-3">
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <label for="brand" class="form-label">Brand</label>
                                <input
                                        type="text"
                                        class="form-control"
                                        id="brand"
                                        name="brand"
                                        placeholder="Enter Brand"
                                        required
                                />
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="itemType" class="form-label"
                                    >Type of Item</label
                                    >
                                    <input
                                            type="text"
                                            class="form-control"
                                            id="itemType"
                                            name="itemType"
                                            placeholder="Enter Type of Item"
                                            required
                                    />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-2">
                                    <label for="size" class="form-label">Size</label>
                                    <input
                                            type="text"
                                            class="form-control"
                                            id="size"
                                            name="size"
                                            placeholder="Enter Size"
                                            required
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-8 mb-2">
                                        <label for="weight" class="form-label">Weight</label>
                                        <input
                                                type="number"
                                                class="form-control"
                                                id="weight"
                                                name="weight"
                                                placeholder="Enter Weight"
                                                required
                                        />
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <label for="weightUnit" class="form-label">Unit</label>
                                        <select
                                                class="form-control"
                                                id="weightUnit"
                                                name="weightUnit"
                                        >
                                            <option value="g">g</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="itemPhoto" class="form-label">Photo</label>
                                    <input
                                            type="file"
                                            class="form-control"
                                            id="itemPhoto"
                                            name="itemPhoto"
                                            accept="image/*"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button
                                    type="submit"
                                    class="btn btn-primary"
                                    id="saveItem"
                            >
                                Add Item
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Item Modal -->
    <div
            class="modal fade"
            id="editItemModal"
            tabindex="-1"
            aria-labelledby="editItemModalLabel"
            aria-hidden="true"
    >
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editItemModalLabel">
                        <i class="fa-solid fa-shirt"></i> Edit Item
                    </h5>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                    ></button>
                </div>
                <div class="modal-body">
                    <form id="editItemForm" class="row g-3">
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <label for="editBrand" class="form-label">Brand</label>
                                <input
                                        type="text"
                                        class="form-control"
                                        id="editBrand"
                                        name="brand"
                                        placeholder="Enter Brand"
                                />
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="editItemType" class="form-label"
                                    >Type of Item</label
                                    >
                                    <input
                                            type="text"
                                            class="form-control"
                                            id="editItemType"
                                            name="itemType"
                                            placeholder="Enter Type of Item"
                                    />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-2">
                                    <label for="editSize" class="form-label">Size</label>
                                    <input
                                            type="text"
                                            class="form-control"
                                            id="editSize"
                                            name="size"
                                            placeholder="Enter Size"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-8 mb-2">
                                        <label for="editWeight" class="form-label">Weight</label>
                                        <input
                                                type="number"
                                                class="form-control"
                                                id="editWeight"
                                                name="weight"
                                                placeholder="Enter Weight"
                                        />
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <label for="editWeightUnit" class="form-label"
                                        >Unit</label
                                        >
                                        <select
                                                class="form-control"
                                                id="editWeightUnit"
                                                name="weightUnit"
                                        >
                                            <option value="g">g</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editItemPhoto" class="form-label">Photo</label>
                                    <input
                                            type="file"
                                            class="form-control"
                                            id="editItemPhoto"
                                            name="itemPhoto"
                                            accept="image/*"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button
                                    type="submit"
                                    class="btn btn-primary"
                                    data-bs-target="itemsModal"
                                    id="updateItem"
                            >
                                Update Item
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Item Modal -->
    <div
            class="modal fade"
            id="deleteItemModal"
            tabindex="-1"
            aria-labelledby="deleteItemModalLabel"
            aria-hidden="true"
    >
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteItemModalLabel">
                        <i class="fa-solid fa-shirt"></i> Delete Item
                    </h5>
                    <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                    ></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this item?</p>
                </div>
                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal"
                    >
                        No
                    </button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteItem">
                        Yes
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="showPhotoModal" tabindex="-1" aria-labelledby="showPhotoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="showPhotoModalLabel">Photo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <img src="https://api.dicebear.com/8.x/shapes/svg?seed=undefined" class="img-fluid" alt="Photo"
                         id="showPhotoModalImage">
                </div>
            </div>
        </div>
    </div>

    <!-- Details Modal -->
    <div
            class="modal fade"
            id="detailsModal"
            tabindex="-1"
            aria-labelledby="detailsModalLabel"
            aria-hidden="true"
    >
