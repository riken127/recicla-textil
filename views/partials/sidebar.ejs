    <link rel="stylesheet" href="/stylesheets/sidebar.css">
    <style>
        body {
            animation: trasitionIn 0.75s;
        }



        @keyframes trasitionIn {
            from{
                opacity: 0;
                transform: rotateX(-10deg);
            }

            to{

                opacity: 1;
                transform: rotateX(0);
            }
        }
    </style>
    <link rel="icon" href="/icon.ico" type="image/x-icon">
    </head>
<body>
<main>
    <div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" style="width: 280px;">
        <a href="#" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <i class="fa-solid fa-socks fa-2xl"></i>&nbsp;<span class="fs-4 px-2">reciclatextil</span>
        </a>
        <hr>
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <div class="dropdown">
                    <a href="#" class="nav-link dropdown-toggle <%= currentRoute === '/users/all' || currentRoute === '/dashboard/users' ? 'active' : 'text-white' %>
                        " id="usersDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-users fx-2"></i>&nbsp; Users
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="usersDropdown">
                        <li><a class="dropdown-item" href="/users/all"><i class="fa-solid fa-table-cells"></i>&nbsp;All</a></li>
                        <li><a class="dropdown-item" href="/dashboard/users"><i class="fa-solid fa-chart-area"></i>&nbsp;Dashboard</a></li>
                    </ul>
                </div>
            </li>
            <li class="nav-item">
                <div class="dropdown">
                    <a href="#" class="nav-link dropdown-toggle <%= currentRoute === '/benefactors/all' || currentRoute === '/dashboard/benefactors' ? 'active' : 'text-white' %>" id="benefactorsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-building fx-2"></i>&nbsp; Benefactors
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="benefactorsDropdown">
                        <li><a class="dropdown-item" href="/benefactors/all"><i class="fa-solid fa-table-cells"></i>&nbsp;All</a></li>
                        <li><a class="dropdown-item" href="/dashboard/benefactors"><i class="fa-solid fa-chart-area"></i>&nbsp;Dashboard</a></li>
                    </ul>
                </div>
            </li>
            <li class="nav-item">
                <div class="dropdown">
                    <a href="#" class="nav-link dropdown-toggle <%= currentRoute === '/donations/all' || currentRoute === '/dashboard/donations' ? 'active' : 'text-white' %>" id="donationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-hand-holding-heart fx-2"></i>&nbsp; Donations
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="donationsDropdown">
                        <li><a class="dropdown-item" href="/donations/all"><i class="fa-solid fa-table-cells"></i>&nbsp;All</a></li>
                        <li><a class="dropdown-item" href="/dashboard/donations"><i class="fa-solid fa-chart-area"></i>&nbsp;Dashboard</a></li>
                    </ul>
                </div>
            </li>
            <li class="nav-item">
                <a href="/home" class="nav-link <%= currentRoute === '/home' ? 'active' : 'text-white' %>"><i class="fa-solid fa-home"></i>&nbsp;Home</a>
            </li>
        </ul>

        <hr>
        <div class="dropdown">
            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                <% if (!pfp) { %>
                    <img src="https://api.dicebear.com/8.x/lorelei-neutral/svg?seed=anakin&amp;flip=true&amp;rotate=10&amp;backgroundType=gradientLinear&amp;glassesProbability=25" alt="" width="32" height="32" class="rounded-circle me-2">
                <% } else { %>
                    <img src="../<%- pfp %>" alt="" width="32" height="32" class="rounded-circle me-2">
                <% } %>
                <strong><%- username %></strong>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                <li>
                    <a id="logout-link" class="dropdown-item" href="#">Sign out</a>
                </li>
            </ul>

        </div>
    </div>
    <script>
        document.getElementById('logout-link').addEventListener('click', function(event) {
            event.preventDefault();
            fetch('/auth/logout', {
                method: 'POST'
            })
                .then(response => {
                    if (response.redirected) {
                        window.location.href = response.url;
                    }
                })
                .catch(error => {
                    console.error('Error logging out:', error);
                });
        });
    </script>
