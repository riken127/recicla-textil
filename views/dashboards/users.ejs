<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Dashboard</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  />
  <script crossorigin="anonymous" src="https://kit.fontawesome.com/3eb5f00bae.js"></script>
  <link rel="stylesheet" href="//unpkg.com/bootstrap@3.3.7/dist/css/bootstrap.min.css" type="text/css" />
  <link rel="stylesheet" href="//unpkg.com/bootstrap-select@1.12.4/dist/css/bootstrap-select.min.css" type="text/css" />
  <link rel="stylesheet" href="//unpkg.com/bootstrap-select-country@4.0.0/dist/css/bootstrap-select-country.min.css" type="text/css" />
</head>

<body>
  <div class="container my-3 py-4">
    <div class="accordion" id="dashboardAccordion">

      <!-- Users Per Month Accordion -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="usersPerMonthHeading">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#usersPerMonthCollapse" aria-expanded="true" aria-controls="usersPerMonthCollapse">
            Users Per Month
          </button>
        </h2>
        <div id="usersPerMonthCollapse" class="accordion-collapse collapse show" aria-labelledby="usersPerMonthHeading" data-bs-parent="#dashboardAccordion">
          <div class="accordion-body">
            <canvas id="usersPerMonth"></canvas>
          </div>
        </div>
      </div>

      <!-- Leafs Per Country Accordion -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="leafsPerCountryHeading">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#leafsPerCountryCollapse" aria-expanded="false" aria-controls="leafsPerCountryCollapse">
            Leafs Per Country
          </button>
        </h2>
        <div id="leafsPerCountryCollapse" class="accordion-collapse collapse" aria-labelledby="leafsPerCountryHeading" data-bs-parent="#dashboardAccordion">
          <div class="accordion-body">
            <canvas id="leafsPerCountry"></canvas>
          </div>
        </div>
      </div>

      <!-- Role Distribution Accordion -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="roleDistributionHeading">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#roleDistributionCollapse" aria-expanded="false" aria-controls="roleDistributionCollapse">
            Role Distribution
          </button>
        </h2>
        <div id="roleDistributionCollapse" class="accordion-collapse collapse" aria-labelledby="roleDistributionHeading" data-bs-parent="#dashboardAccordion">
          <div class="accordion-body">
            <canvas id="roleDistribution"></canvas>
          </div>
        </div>
      </div>

      <!-- Title Distribution Accordion -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="titleDistributionHeading">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#titleDistributionCollapse" aria-expanded="false" aria-controls="titleDistributionCollapse">
            Title Distribution
          </button>
        </h2>
        <div id="titleDistributionCollapse" class="accordion-collapse collapse" aria-labelledby="titleDistributionHeading" data-bs-parent="#dashboardAccordion">
          <div class="accordion-body">
            <canvas id="titleDistribution"></canvas>
          </div>
        </div>
      </div>

      <!-- Percentage Per Country Accordion -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="percentagePerCountryHeading">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#percentagePerCountryCollapse" aria-expanded="false" aria-controls="percentagePerCountryCollapse">
            Percentage Per Country
          </button>
        </h2>
        <div id="percentagePerCountryCollapse" class="accordion-collapse collapse" aria-labelledby="percentagePerCountryHeading" data-bs-parent="#dashboardAccordion">
          <div class="accordion-body">
            <canvas id="percentagePerCountry"></canvas>
          </div>
        </div>
      </div>

      <!-- Percentage Per Language Accordion -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="percentagePerLanguageHeading">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#percentagePerLanguageCollapse" aria-expanded="false" aria-controls="percentagePerLanguageCollapse">
            Percentage Per Language
          </button>
        </h2>
        <div id="percentagePerLanguageCollapse" class="accordion-collapse collapse" aria-labelledby="percentagePerLanguageHeading" data-bs-parent="#dashboardAccordion">
          <div class="accordion-body">
            <div class="chart-container">
              <canvas id="percentagePerLanguage"></canvas>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    console.log(<%- JSON.stringify(data) %>);
    const ppl = document.getElementById("percentagePerLanguage");
    const ubm = document.getElementById("usersPerMonth");
    const lpc = document.getElementById("leafsPerCountry");
    const rld = document.getElementById("roleDistribution");
    const tid = document.getElementById("titleDistribution");
    const ppc = document.getElementById("percentagePerCountry");

    <% let usersByMonth = data[0];
    let percentagePerCountry = data[1];
    let percentagePerLanguage = data[2];
    let roleDistribution = data[3];
    let titleDistribution = data[4];
    let pointsPerCountry = data[5][0];
    function getMonthName(monthNumber) {
      const monthNames = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
      return monthNames[monthNumber - 1];
    } %>

    new Chart(ppl, {
      type: 'doughnut',
      data: {
        labels: <%- JSON.stringify(percentagePerLanguage.map(item => item.language)) %>,
        datasets: [{
          data: <%= JSON.stringify(percentagePerLanguage.map(item => item.percentage)) %>,
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false
      }
    });

    new Chart(ubm, {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(usersByMonth.map(item => getMonthName(item.month))) %>,
        datasets: [{
          label: 'Total Users',
          data: <%- JSON.stringify(usersByMonth.map(item => item.totalUsers)) %>,
          fill: false,
          borderColor: 'rgb(75, 192, 192)',
          tension: 0.1
        }]
      }
    });

    new Chart(lpc, {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(pointsPerCountry.countries.map(item => item.country)) %>,
        datasets: [{
          label: 'Leafs',
          data: <%= JSON.stringify(pointsPerCountry.countries.map(item => item.points)) %>,
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
      }
    });

    new Chart(rld, {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(roleDistribution.map(item => item._id[0])) %>,
        datasets: [{
          label: 'Number of people in a given role',
          data: <%= JSON.stringify(roleDistribution.map(item => item.count)) %>,
          backgroundColor: 'purple'
        }]
      }
    });

    new Chart(tid, {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(titleDistribution.map(item => item._id[0] || 'Nenhum')) %>,
        datasets: [{
          label: 'Number of people with a certain title',
          data: <%= JSON.stringify(titleDistribution.map(item => item.count)) %>,
          backgroundColor: 'red'
        }]
      }
    });

    new Chart(ppc, {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(percentagePerCountry.map(item => item.country)) %>,
        datasets: [{
          label: 'Country Percentage',
          data: <%- JSON.stringify(percentagePerCountry.map(item => item.percentage)) %>,
          backgroundColor: 'blue'
        }]
      }
    });
  </script>
</body>
</html>
