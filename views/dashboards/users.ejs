<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Users</title>
    <script src="https://d3js.org/d3.v6.min.js"></script>

</head>

<body>

<% for (const item of data) { %>
    <div>
        <% for (const key in item) { %>
            <p><%= key %>: <%= item[key] %></p>
        <% } %>
    </div>
<% } %>
<script>
    console.log(<%- JSON.stringify(data) %>);
</script>
</body>
</html>