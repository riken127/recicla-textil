<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Benefactors Dashboard</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script
      crossorigin="anonymous"
      src="https://kit.fontawesome.com/3eb5f00bae.js"
    ></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300..700&family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <style>
      body {
        background-color: #f8f9fa;
        font-family: "Public Sans", sans-serif;
      }
      .header {
        background-color: #343a40;
        color: #f8f9fa;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
      }
      .header-title {
        font-weight: 700;
        font-size: 3.2rem;
        color: #f8f9fa;
      }
      .chart-container {
        position: relative;
        height: 250px;
      }
      /* Custom CSS for layout */
      .header-content {
        padding: 15px;
        text-align: left;
        border-radius: 15px;
        margin-bottom: 15px;
      }
      .header-content h3,
      .header-content h2 {
        margin-bottom: 10px;
      }
      .badge {
        font-size: 0.9em;
      }
    </style>
  </head>
  <body class="py-2">
    <div class="container mt-4">
      <div class="row">
        <div class="col-12">
          <div class="header border-0 rounded shadow">
            <div class="row align-items-center">
              <div class="col-md-6">
                <h1 class="header-title">
                  <i class="fas fa-socks fa-lg"></i>&nbsp;reciclatextil
                </h1>
                <div class="py-3 px-3">
                  <h3><i class="fas fa-users"></i>&nbsp; <%= data[5] %></h3>
                  <h3>
                    <i class="fas fa-leaf"></i>&nbsp; <%=
                    data[6][0].totalPickpoints %>
                  </h3>
                </div>
              </div>
              <div class="col-md-6">
                <h2>Benefactor Activity</h2>
                <div class="chart-container">
                  <canvas id="benefactorActivity"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="jumbotron py-3">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <h1 class="display-6">Donation Insights</h1>
          </div>
          <div class="col-md-6">
            <div class="card bg-white border-0 shadow">
              <div class="card-body">
                <h2 class="card-title">Country Donations</h2>
                <div class="chart-container">
                  <canvas id="countryDonations"></canvas>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card bg-white border-0 shadow">
              <div class="card-body">
                <h2 class="card-title">Benefactor Types</h2>
                <div class="chart-container">
                  <canvas id="benefactorTypes"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="container py-3">
      <div class="row">
        <div class="col-12">
          <h1 class="display-6">Top Benefactors</h1>
        </div>
        <div class="col-md-6">
          <div class="card bg-white border-0 shadow">
            <div class="card-body">
              <h2 class="card-title">Top Countries</h2>
              <ul class="list-group">
                <% data[0].forEach(function(item) { %>
                <li
                  class="list-group-item d-flex justify-content-between align-items-center"
                >
                  <%= item._id %>
                  <span class="badge bg-primary rounded-pill"
                    ><%= item.totalPickpoints %></span
                  >
                </li>
                <% }); %>
              </ul>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card bg-white border-0 shadow">
            <div class="card-body">
              <h2 class="card-title">Top Cities</h2>
              <ul class="list-group">
                <% data[1].forEach(function(item) { %>
                <li
                  class="list-group-item d-flex justify-content-between align-items-center"
                >
                  <%= item._id %>
                  <span class="badge bg-primary rounded-pill"
                    ><%= item.count %></span
                  >
                </li>
                <% }); %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
            console.log(<%- JSON.stringify(data) %>);
            const ba = document.getElementById("benefactorActivity");
            const cd = document.getElementById("countryDonations");
            const bt = document.getElementById("benefactorTypes");

            <% let benefactorActivity = data[4];
            let countryDonations = data[1];
            let benefactorTypes = data[2];
            function getMonthName(monthNumber) {
              const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
              return monthNames[monthNumber - 1];
            } %>
            new Chart(ba, {
    type: 'line',
    data: {
        labels: benefactorActivity.map(item => getMonthName(item._id)),
        datasets: [
            {
                label: 'Updates Per Month',
                data: benefactorActivity.map(item => item.updates),
                yAxisID: 'y',
            },
            {
                label: 'Creates Per Month',
                data: benefactorActivity.map(item => item.creates),
                yAxisID: 'y1',
            }
        ]
    },
    options: {
        responsive: true,
        interaction: {
            mode: 'index',
            intersect: false
        },
        stacked: false,
        scales: {
            yAxes: [
                {
                    id: 'y',
                    type: 'linear',
                    position: 'left'
                },
                {
                    id: 'y1',
                    type: 'linear',
                    position: 'right'
                }
            ]
        }
    }
});



            new Chart(cd, {
              type: 'bar',
              data: {
                labels: <%- JSON.stringify(countryDonations.map(item => item._id)) %>,
                datasets: [{
                  label: 'Donation Count',
                  data: <%- JSON.stringify(countryDonations.map(item => item.count)) %>,
                  backgroundColor: '#FF6B6B'
                }]
              }
            });

            new Chart(bt, {
              type: 'doughnut',
              data: {
                labels: <%- JSON.stringify(benefactorTypes.map(item => item.type)) %>,
                datasets: [{
                  data: <%= JSON.stringify(benefactorTypes.map(item => item.count)) %>,
                  borderWidth: 1,
                  backgroundColor: [
                    '#FF6B6B',
                    '#FFD166',
                    '#06D6A0',
                    '#118AB2',
                    '#073B4C',
                  ],
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: {
                  position: 'bottom',
                },
              }
            });
    </script>
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
