<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script crossorigin="anonymous" src="https://kit.fontawesome.com/3eb5f00bae.js"></script>
    <link rel="stylesheet" href="//unpkg.com/bootstrap@3.3.7/dist/css/bootstrap.min.css" type="text/css"/>
    <link rel="stylesheet" href="//unpkg.com/bootstrap-select@1.12.4/dist/css/bootstrap-select.min.css"
          type="text/css"/>
    <link rel="stylesheet" href="//unpkg.com/bootstrap-select-country@4.0.0/dist/css/bootstrap-select-country.min.css"
          type="text/css"/>
    <script src="//unpkg.com/jquery@3.4.1/dist/jquery.min.js"></script>
    <script src="//unpkg.com/bootstrap@3.3.7/dist/js/bootstrap.min.js"></script>
    <script src="//unpkg.com/bootstrap-select@1.12.4/dist/js/bootstrap-select.min.js"></script>
    <script src="//unpkg.com/bootstrap-select-country@4.0.0/dist/js/bootstrap-select-country.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/user/userStyles.css">
</head>
<body style="margin-top: 100px;">
<div class="container mb-3 justify-content-center d-flex">
    <form class="row g-3 col-6" action="">
        <div class="col-md-12 d-flex justify-content-center">
            <h1>Create User</h1>
        </div>
        <hr style="border-top: 4px solid black;">
        <div class="col-md-6">
            <label class="form-label" for="inputFirstName">First Name</label>
            <input class="form-control" id="inputFirstName" name="firstName" type="text" placeholder="First Name">
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputLastName">Last Name</label>
            <input class="form-control" id="inputLastName" name="lastName" type="text" placeholder="Last Name">
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputUsername">Username</label>
            <input class="form-control" id="inputUsername" name="username" type="text" placeholder="Username">
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputPhoneNumber">Phone Number</label>
            <input class="form-control" id="inputPhoneNumber" name="phoneNumber" type="text" placeholder="Phone Number">
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputPassword">Password</label>
            <div class="input-group">
                <input class="form-control" id="inputPassword" type="password" placeholder="Password">
                <div class="input-group-append">
                    <button class="btn btn-outline-secondary reveal" type="button"><i class="fa fa-eye"></i></button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputRepeatPassword">Repeat Password</label>
            <div class="password-input-container position-relative">
                <input class="form-control" id="inputRepeatPassword" type="password" placeholder="Repeat Password">
                <div class="input-group-append">
                    <button class="btn btn-outline-secondary reveal" type="button"><i class="fa fa-eye"></i></button>
                </div>
            </div>
        </div>

        <div class="col-md-12 position-relative">
            <label class="form-label" for="inputEmailAddress">Email Address</label>
            <input class="form-control" id="inputEmailAddress" type="email" placeholder="Email Address">
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputImage">Image</label>
            <input class="form-control" id="inputImage" name="image" type="file">
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputRole">Role</label>
            <select class="form-select form-select-lg" id="inputRole">
                <option selected>Choose Option</option>
                <option>Admistrador</option>
                <option>Employee</option>
                <option>User</option>
                <option>Moderator</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputStreet">Street</label>
            <input class="form-control" id="inputStreet" type="text" placeholder="Street">
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputZipCode">Zip Code</label>
            <input class="form-control" id="inputZipCode" type="text" placeholder="Zip Code">
        </div>
        <div class="col-md-6">
            <label class="form-label" for="inputCity">City</label>
            <input class="form-control" id="inputCity" type="text" placeholder="City">
        </div>
        <div class="col-md-6 mb-4">
            <label class="form-label" for="inputState">Country</label>
            <select class="form-control selectpicker countrypicker" data-flag="true" placeholder="Country"></select>
        </div>

        <hr style="border-top: 4px solid black;">
        <div class="col-md-12 d-flex justify-content-center">
            <button class="btn bg-dark btn-lg text-light" type="submit">Register</button>
        </div>
    </form>
</div>

<script>
    $('.countrypicker').countrypicker();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
<script src="/javascripts/misc/countries-config.js"></script>
<script src="/javascripts/user/userScripts.js"></script>
</body>
<%- include('../partials/footer') %>
<html>