<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Donations</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css"/>
    <script crossorigin="anonymous" src="https://kit.fontawesome.com/3eb5f00bae.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.3/css/dataTables.bootstrap5.css"/>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/country-select-js/2.0.3/css/countrySelect.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@21.1.4/build/css/intlTelInput.css">
    <style>
        .country-select {
            width: 100%;
        }

        .iti {
            width: 100%;
        }
    </style>
</head>

<body>
<div class="container md-col-12 mb-3 py-4">
    <table id="donationsTable" class="table table-striped display" style="width: 100%">
    </table>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createModalLabel">Create Donation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createDonationForm" method="POST">
                    <div class="accordion" id="accordionCreate">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingCreateOne">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#collapseCreateOne" aria-expanded="true"
                                        aria-controls="collapseCreateOne">
                                    Shipping Information
                                </button>
                            </h2>
                            <div id="collapseCreateOne" class="accordion-collapse collapse show"
                                 aria-labelledby="headingCreateOne" data-bs-parent="#accordionCreate">
                                <div class="accordion-body">
                                    <div class="row">
                                        <label for="createUserId" class="form-label">User</label>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <input type="text" class="form-control" id="createUserId" name="userId"
                                                       readonly>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                                                        data-bs-target="#userModal">
                                                    Select User
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <label for="createBenefactor" class="form-label">Benefactor</label>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <input type="text" class="form-control" id="createBenefactor"
                                                       name="benefactor" readonly>
                                                <input type="hidden" id="selectedBenefactorId" name="benefactorId">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                                                        data-bs-target="#benefactorModal">
                                                    Select Benefactor
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingCreateTwo">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#collapseCreateTwo" aria-expanded="false"
                                        aria-controls="collapseCreateTwo">
                                    Item Details
                                </button>
                            </h2>
                            <div id="collapseCreateTwo" class="accordion-collapse collapse"
                                 aria-labelledby="headingCreateTwo" data-bs-parent="#accordionCreate">
                                <div class="accordion-body">
                                    <table id="itemsTable" class="table">
                                        <thead>
                                        <tr>
                                            <th scope="col">Brand</th>
                                            <th scope="col">Weight</th>
                                            <th scope="col">Size</th>
                                            <th scope="col">Type of item</th>
                                            <th scope="col">Photo of the item</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>

                                    <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#addItemModal">
                                        Add Item
                                    </button>
                                </div>
                                <input type="hidden" id="items" name="items">
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingCreateThree">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#collapseCreateThree" aria-expanded="false"
                                        aria-controls="collapseCreateThree">
                                    Order Information
                                </button>
                            </h2>
                            <div id="collapseCreateThree" class="accordion-collapse collapse"
                                 aria-labelledby="headingCreateThree" data-bs-parent="#accordionCreate">
                                <div class="accordion-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="mb-2">
                                                <label for="totalWeight" class="form-label">Total Weight</label>
                                                <input type="text" class="form-control" id="totalWeight"
                                                       name="totalWeight" readonly>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-2">
                                                <label for="numberItens" class="form-label">Number of Itens</label>
                                                <input type="text" class="form-control" id="numberItens"
                                                       name="numberItens" readonly>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-2">
                                                <label for="createPickpoint" class="form-label">Pickpoint</label><br>
                                                <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                                                        data-bs-target="#pickpointModal">
                                                    Select Pickpoint
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="createcountry" class="form-label">Country</label>
                                                <input type="text" class="form-control" id="createCountry"
                                                       name="country" readonly>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="createCity" class="form-label">City</label>
                                                <input type="text" class="form-control" id="createCity" name="city"
                                                       readonly>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="createStreet" class="form-label">Street</label>
                                                <input type="text" class="form-control" id="createStreet" name="street"
                                                       readonly>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="createPostalCode" class="form-label">Postal Code</label>
                                                <input type="text" class="form-control" id="createPostalCode"
                                                       name="postalCode" readonly>
                                            </div>
                                        </div>
                                        <input type="hidden" id="createActivityType" name="activityType"
                                               value="donation">
                                        <input type="hidden" id="createTimestamp" name="timestamp"
                                               value="<%= new Date().toISOString() %>">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Create Donation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="userModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Users</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input class="form-control" id="userSearch" type="text" placeholder="Search...">
                <div id="userContainer"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<div class="modal" id="benefactorModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Benefactor</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input class="form-control" id="benefactorSearch" type="text"
                       placeholder="Search by benefactor name...">
                <div id="benefactorContainer"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<div class="modal" id="pickpointModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Pickpoints</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input class="form-control" id="pickPoint" type="text" placeholder="Search by city...">
                <% benefactors.forEach(function(benefactor) { %>
                    <% benefactor.pickpoints.forEach(function(pickPoint) { %>
                        <div class="pickPoint-container" data-benefactor-id="<%= benefactor._id %>">
                            <div class="d-flex align-items-center justify-content-between mt-2">
                                <div>
                                    <h5><%= pickPoint.country %>, <%= pickPoint.city %></h5>
                                    <p><%= pickPoint.street %>, <%= pickPoint.postalCode %></p>
                                </div>
                                <button class="btn btn-primary select-pickPoint" data-id="<%= pickPoint._id %>"
                                        data-street="<%= pickPoint.street %>" data-city="<%= pickPoint.city %>"
                                        data-postalcode="<%= pickPoint.postalCode %>"
                                        data-country="<%= pickPoint.country %>">Select
                                </button>
                            </div>
                        </div>
                    <% }); %>
                <% }); %>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addItemModalLabel">Add Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-2">
                            <label for="brand" class="form-label">Brand</label>
                            <input type="text" class="form-control" id="brand" name="brand">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-2">
                            <label for="weight" class="form-label">Weight</label>
                            <input type="text" class="form-control" id="weight" name="weight">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-2">
                            <label for="size" class="form-label">Size</label>
                            <input type="text" class="form-control" id="size" name="size">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="itemType" class="form-label">Type of item</label>
                            <input type="text" class="form-control" id="itemType" name="itemType">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="itemPhoto" class="form-label">Item Photo</label>
                            <input type="file" class="form-control" id="itemPhoto" name="itemPhoto" accept="image/*">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveItem">Save changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailsModal" tabindex="-1" role="dialog" aria-labelledby="detailsModalLabel"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">Detalhes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Donation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this donation?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Yes</button>
            </div>
        </div>
    </div>
</div>

<!-- Add this hidden input field to your form -->
<input type="hidden" id="selectedUserId" name="userId">
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.js"></script>

<!-- DataTables JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script>
    // When the modal is shown, set the timestamp to the current date and time
    $('#createModal').on('show.bs.modal', function (event) {
        var now = new Date();
        var datetimeLocal = now.toISOString().slice(0, 19);
        $('#createTimestamp').val(datetimeLocal);
    });

</script>

<script>
    $('#pickpointModal').on('show.bs.modal', function (e) {
        var benefactorId = $('#selectedBenefactorId').val();
        if (!benefactorId) {
            alert('Please select a benefactor first.');
            e.preventDefault();
        } else {
            $('.pickPoint-container').hide();

            $('.pickPoint-container[data-benefactor-id="' + benefactorId + '"]').show();
        }
    });
</script>
<script>
    $(document).ready(function () {
        $('.select-pickPoint').click(function () {
            var street = $(this).data('street');
            var city = $(this).data('city');
            var postalCode = $(this).data('postalcode');
            var country = $(this).data('country');

            $('#createStreet').val(street);
            $('#createCity').val(city);
            $('#createPostalCode').val(postalCode);
            $('#createCountry').val(country);

            $('#pickpointModal').modal('hide');
        });

        $('#pickpointModal').on('hidden.bs.modal', function (e) {
            $('#createModal').modal('show');
        });

        $('#pickpointSearch').on('keyup', function () {
            var value = $(this).val().toLowerCase();
            $('.pickPoint-container').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });
</script>

<script>
    $('#saveItem').on('click', function () {
        // Get the values from the form fields
        var brand = $('#brand').val();
        var weight = parseInt($('#weight').val()) || 0; // Convert to number and use 0 if not a number
        var size = $('#size').val();
        var itemType = $('#itemType').val();
        var itemPhoto = $('#itemPhoto')[0].files[0]; // Get the selected file

        // Check if all fields have valid values before adding the item
        if (brand && weight && size && itemType && itemPhoto) {
            // Create an object URL for the file
            var objectUrl = URL.createObjectURL(itemPhoto);

            // Add a new row to the table with the values
            $('#itemsTable tbody').append('<tr><td class="item-brand">' + brand + '</td><td class="item-weight">' + weight + '</td><td class="item-size">' + size + '</td><td class="item-type">' + itemType + '</td><td><img src="' + objectUrl + '" alt="Item Photo" width="50" height="50"></td></tr>');
        }

        // Clear the form fields
        $('#brand').val('');
        $('#weight').val('');
        $('#size').val('');
        $('#itemType').val('');
        $('#itemPhoto').val('');

        // Close the modal
        $('#addItemModal').modal('hide');

        // Open the create donation modal
        $('#createModal').modal('show');

        // Update the total weight and number of items
        updateTotals();
    });

    function updateTotals() {
        var totalWeight = 0;
        var numberOfItems = 0;

        $('#itemsTable tbody tr').each(function () {
            var weight = parseInt($(this).find('.item-weight').text()) || 0;
            var brand = $(this).find('.item-brand').text();

            // Only count the item if it has a valid brand and weight
            if (brand && weight) {
                totalWeight += weight;
                numberOfItems++;
            }
        });

        // Update the total weight and number of items fields
        $('#totalWeight').val(totalWeight);
        $('#numberItens').val(numberOfItems);
    }

</script>
<script>
    $(document).ready(function () {
        // Quando o modal de usuário é mostrado, remover o modal de criação da pilha de modais
        $('#userModal').on('show.bs.modal', function () {
            $('body').addClass('test');
            $('.modal-backdrop').last().css('z-index', 1051);
        });

        // Quando o modal de usuário é escondido, adicionar o modal de criação de volta à pilha de modais
        $('#userModal').on('hidden.bs.modal', function () {
            $('body').removeClass('test');
            $('.modal-backdrop').last().css('z-index', 1040);
            $('#createModal').modal('show'); // Mostrar o modal de criação novamente
        });
    });

    $('#userSearch').on('input', function () {
        var searchValue = $(this).val();

        $.ajax({
            url: '/users/all-users',
            type: 'POST',
            data: {'search[value]': searchValue, length: 10},
            success: function (users) {
                $('#userContainer').empty(); // Limpar o container antes de adicionar novos usuários
                console.log(users);
                users.data.forEach((user) => {
                    $('#userContainer').append(`
                    <div class="user-container">
                        <div class="d-flex align-items-center justify-content-between mt-2">
                            <div>
                                <h5>${user.username}</h5>
                                <h6>${user.firstName} ${user.lastName}</h6>
                                <p>${user._id}</p>
                            </div>
                            <button class="btn btn-primary select-user" data-id="${user._id}">Select</button>
                        </div>
                    </div>
                `);
                });
            }
        });
    });

    $(document).ready(function () {
        $('body').on('click', '.select-user', function () {
            var userId = $(this).data('id');
            $('#createUserId').val(userId);
            $('#userModal').modal("hide");
        });
    });

</script>


<script>
    $(document).ready(function () {
        // Quando o modal de usuário é mostrado, remover o modal de criação da pilha de modais
        $('#benefactorModal').on('show.bs.modal', function () {
            $('body').addClass('test');
            $('.modal-backdrop').last().css('z-index', 1051);
        });

        // Quando o modal de usuário é escondido, adicionar o modal de criação de volta à pilha de modais
        $('#benefactor Modal').on('hidden.bs.modal', function () {
            $('body').removeClass('test');
            $('.modal-backdrop').last().css('z-index', 1040);
            $('#createModal').modal('show'); // Mostrar o modal de criação novamente
        });
    });

    $('#benefactorSearch').on('input', function () {
        var searchValue = $(this).val();

        $.ajax({
            url: '/benefactors/all-benefactors',
            type: 'POST',
            data: {'search[value]': searchValue, length: 10},
            success: function (benefactors) {
                $('#benefactorContainer').empty();
                console.log(benefactors);
                benefactors.data.forEach((benefactor) => {
                    $('#benefactorContainer').append(`
                        <div class="benefactor-container">
                            <div class="d-flex align-items-center justify-content-between mt-2">
                                <div>
                                    <h5>${benefactor.name}</h5>
                                    <p>${benefactor._id}</p>
                                </div>
                                <button class="btn btn-primary select-benefactor" data-id="${benefactor._id}">Select</button>
                            </div>
                        </div>
                    `);
                });
            }
        });
    });

    $(document).ready(function () {
        $('body').on('click', '.select-benefactor', function () {
            var benefactorId = $(this).data('id');
            $('#createBenefactorId').val(benefactorId);
            $('#benefactorModal').modal("hide");
        });
    });
</script>


<script>
    function formatLabel(label) {
        // Split the label on uppercase letters
        var words = label.split(/(?=[A-Z])/);

        // Convert the first letter of each word to uppercase and the rest to lowercase
        words = words.map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase());

        // Join the words back together with spaces
        return words.join(' ');
    }

    $(document).on('click', '.details-btn', function () {
        var details = $(this).data('details');
        var itemsList = "";
        var orderInfoList = "";

        var orderInfoKeys = ['totalWeight', 'numberOfItems', 'country', 'city', 'street', 'postalCode'];

        for (var key in details) {
            var label = formatLabel(key);

            if (key === 'items') {
                itemsList += `
    <div class="accordion-item">
        <h2 class="accordion-header" id="heading${key}">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse${key}" aria-expanded="false" aria-controls="collapse${key}">
                Items Information
            </button>
        </h2>
        <div id="collapse${key}" class="accordion-collapse collapse" aria-labelledby="heading${key}" data-bs-parent="#accordionDetails">
            <div class="accordion-body">
                <table id="itemsTable" class="table">
                    <thead>
                        <tr>
                            <th scope="col">Brand</th>
                            <th scope="col">Weight</th>
                            <th scope="col">Size</th>
                            <th scope="col">Type</th>
                            <th scope="col">Image</th>
                        </tr>
                    </thead>
                    <tbody>
    `;

                details[key].forEach(function (item) {
                    itemsList += `
            <tr>
                <td>${item.brand}</td>
                <td>${item.weight}</td>
                <td>${item.size}</td>
                <td>${item.itemType}</td>
                <td><img src="${item.imageUrl}" alt="${item.type}"></td>
            </tr>
        `;
                });

                itemsList += `
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    `;
            } else if (orderInfoKeys.includes(key)) {
                orderInfoList += `
                <li class="details-item">
                    <strong>${label}:</strong> ${details[key]}
                </li>
            `;
            }
        }

        var orderInfoAccordion = `
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOrderInfo">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOrderInfo" aria-expanded="false" aria-controls="collapseOrderInfo">
                Order Information
            </button>
        </h2>
        <div id="collapseOrderInfo" class="accordion-collapse collapse" aria-labelledby="headingOrderInfo" data-bs-parent="#accordionDetails">
            <div class="accordion-body">
                <ul class="details-sublist" style="list-style-type: none;">
                    ${orderInfoList}
                </ul>
            </div>
        </div>
    </div>
`;

        $('#detailsModalBody').html(`<h3 style="text-align: center;">Benefactor Name: ${details.benefactor}</h3><div class="accordion" id="accordionDetails">${itemsList}${orderInfoAccordion}</div>`);
        $('#detailsModal').modal('show');
    });

    $(document).on('click', '.modal-footer .btn', function () {
        $('#detailsModal').modal('hide');
    });

</script>


