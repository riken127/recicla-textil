            <div class="modal-body">
                <p>Are you sure you want to delete this user?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Yes</button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.js"></script>

<!-- DataTables JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

<!-- Bootstrap Bundle (Bootstrap JS and Popper.js) -->
<script src="https://cdn.datatables.net/2.0.3/js/dataTables.js"></script>
<script src="https://cdn.datatables.net/2.0.3/js/dataTables.bootstrap5.js"></script>
<!-- DataTables Buttons JavaScript -->
<script type="text/javascript" src="https://cdn.datatables.net/buttons/3.0.1/js/buttons.dataTables.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/buttons/3.0.1/js/dataTables.buttons.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/buttons/2.3.0/js/buttons.html5.min.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/buttons/2.3.0/js/buttons.print.min.js"></script>
<!-- Initialization script -->
<!-- Include intl-tel-input JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@21.1.4/build/js/intlTelInput.min.js"></script>
<!-- Include country-select-js JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/country-select-js/2.0.3/js/countrySelect.min.js"></script>
<!-- Include ajax table Initialization -->
<script src="/javascripts/users/table.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
    // Initialize "create" country selector
    $('#createcountry').countrySelect();
    // Initialize "edit" country selector
    $('#editcountry').countrySelect();
    // Initialize "create" phone input
    var createPhoneInput = document.querySelector("#createphone");
    var createIti = window.intlTelInput(createPhoneInput, {
        initialCountry: "pt",
        separateDialCode: true,
        utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@21.1.4/build/js/utils.js",
    });
    // Initialize "edit" phone input
    var editPhoneInput = document.querySelector("#editphone");
    var editIti = window.intlTelInput(editPhoneInput, {
        separateDialCode: true,
        utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@21.1.4/build/js/utils.js",
    });


    const handleChange = () => {
        let text;
        if (createPhoneInput.value) {
            text = createIti.isValidNumber()
                ? "Valid number! Full international format: " + createIti.getNumber()
                : "Invalid number - please try again";
        } else {
            text = "Please enter a valid number below";
        }
        const textNode = document.createTextNode(text);
        output.innerHTML = "";
        output.appendChild(textNode);
    };
</script>
</body>
</html>