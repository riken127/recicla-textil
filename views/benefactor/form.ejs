<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pop-up Form</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
      integrity="sha512-n7b14c+TFxKvL8r4ePitq5R7vXgmjrxIvcA7iGGpG0R5P/RLaB8wTG5NntZIfW2t1KufG3L7Zd/Xsxw7Jqc1OQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body style="margin-top: 20px">
    <!-- Button to trigger modal -->
    <button
      type="button"
      class="btn btn-primary"
      data-bs-toggle="modal"
      data-bs-target="#createBenefactorForm"
    >
      Launch form
    </button>

    <!-- Modal -->
    <div
      class="modal fade"
      id="createBenefactorForm"
      tabindex="-1"
      aria-labelledby="BenefactorFormLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <!-- Modal Header -->
          <div class="modal-header">
            <h5 class="modal-title" id="BenefactorFormLabel">
              <i class="fa-solid fa-building"></i> Create Benefactor
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <!-- Modal Body -->
          <div class="modal-body">
            <form action="#" method="post" class="row g-3">
              <div class="col-md-12">
                <div class="accordion" id="accordionForm">
                  <!-- Credentials Section -->
                  <div class="accordion-item">
                    <h2 class="accordion-header" id="credentialsHeading">
                      <button
                        class="accordion-button"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseCredentials"
                        aria-expanded="true"
                        aria-controls="collapseCredentials"
                      >
                        Credentials
                      </button>
                    </h2>
                    <div
                      id="collapseCredentials"
                      class="accordion-collapse collapse show"
                      aria-labelledby="credentialsHeading"
                      data-bs-parent="#accordionForm"
                    >
                      <div class="accordion-body">
                        <div class="row g-3">
                          <div class="col-md-12">
                            <label class="form-label" for="inputUsername"
                              >Username</label
                            >
                            <input
                              class="form-control"
                              id="inputUsername"
                              name="Username"
                              placeholder="Your Username"
                              type="text"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="inputTelephoneNumber"
                              >Telephone Number</label
                            >
                            <input
                              class="form-control"
                              id="inputTelephoneNumber"
                              name="telephoneNumber"
                              placeholder="Your Phone Number"
                              type="text"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="inputEmail"
                              >Email</label
                            >
                            <input
                              class="form-control"
                              id="inputEmail"
                              placeholder="Your Email"
                              type="email"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="inputPassword"
                              >Password</label
                            >
                            <input
                              class="form-control"
                              id="inputPassword"
                              placeholder="Your Password"
                              type="password"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="inputRepeatPassword"
                              >Repeat Password</label
                            >
                            <input
                              class="form-control"
                              id="inputRepeatPassword"
                              placeholder="Repeat Your Password"
                              type="password"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Profile Section -->
                  <div class="accordion-item">
                    <h2 class="accordion-header" id="profileHeading">
                      <button
                        class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseProfile"
                        aria-expanded="false"
                        aria-controls="collapseProfile"
                      >
                        Profile
                      </button>
                    </h2>
                    <div
                      id="collapseProfile"
                      class="accordion-collapse collapse"
                      aria-labelledby="profileHeading"
                      data-bs-parent="#accordionForm"
                    >
                      <div class="accordion-body">
                        <div class="row g-3">
                          <div class="col-md-12">
                            <label class="form-label" for="inputFirstName"
                              >Name</label
                            >
                            <input
                              class="form-control"
                              id="inputFirstName"
                              name="firstName"
                              placeholder="Your Name"
                              type="text"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="inputLogoImage"
                              >Logo Image</label
                            >
                            <input
                              class="form-control"
                              id="inputLogoImage"
                              name="logoImage"
                              type="file"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="inputBannerImage"
                              >Banner Image</label
                            >
                            <input
                              class="form-control"
                              id="inputBannerImage"
                              name="bannerImage"
                              type="file"
                            />
                          </div>
                          <div class="col-md-12">
                            <label class="form-label" for="descriptionTextarea"
                              >Description</label
                            >
                            <textarea
                              class="form-control"
                              id="descriptionTextarea"
                              placeholder="Write description here..."
                              style="height: 100px"
                            ></textarea>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Address Section -->
                  <div class="accordion-item">
                    <h2 class="accordion-header" id="addressHeading">
                      <button
                        class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseAddress"
                        aria-expanded="false"
                        aria-controls="collapseAddress"
                      >
                        Address
                      </button>
                    </h2>
                    <div
                      id="collapseAddress"
                      class="accordion-collapse collapse"
                      aria-labelledby="addressHeading"
                      data-bs-parent="#accordionForm"
                    >
                      <div class="accordion-body">
                        <div class="row g-3">
                          <div class="col-md-6">
                            <label class="form-label" for="inputStreet"
                              >Street</label
                            >
                            <input
                              class="form-control"
                              id="inputStreet"
                              placeholder="1234 Main St"
                              type="text"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="inputPostalCode"
                              >Postal Code</label
                            >
                            <input
                              class="form-control"
                              id="inputPostalCode"
                              placeholder="Your Postal Code"
                              type="text"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="inputCity"
                              >City</label
                            >
                            <input
                              class="form-control"
                              id="inputCity"
                              placeholder="Your City"
                              type="text"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="inputState"
                              >Country</label
                            >
                            <select class="form-select" id="inputState">
                              <option selected>Choose</option>
                              <option>...</option>
                            </select>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  
                </div>
              </div>
              <!-- Modal Footer -->
              <div class="modal-footer">
                <button type="button" class="btn btn-dark">Create</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <script
      crossorigin="anonymous"
      src="https://kit.fontawesome.com/3eb5f00bae.js"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
